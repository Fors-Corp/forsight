{
  "name": "forsight-web",
  "private": true,
  "type": "module",
  "description": "forsight's dashboard — a small React app built on @marcfs31/forsight, the same design system this repo publishes. Built once via `vite build`; its static output is embedded into the Go binary (see internal/api/dashboard_embed.go).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@marcfs31/forsight": "^4.0.1",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^5.0.0"
  }
}
